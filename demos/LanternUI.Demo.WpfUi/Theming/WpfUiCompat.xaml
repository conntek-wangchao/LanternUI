<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        The bridge: WPF-UI's own control templates read WPF-UI's token names. Merging this after
        WPF-UI's dictionaries (the reference's trick) re-points every WPF-UI control at the Lantern
        palette, so a third-party control set joins the theme instead of fighting it.
    -->

    <SolidColorBrush x:Key="ApplicationBackgroundBrush" Color="#FF242426" />
    <SolidColorBrush x:Key="SolidBackgroundFillColorBaseBrush" Color="#FF242426" />
    <SolidColorBrush x:Key="SolidBackgroundFillColorSecondaryBrush" Color="#FF29292B" />

    <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="#FFF2F2F4" />
    <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="#FFB9B9C0" />
    <SolidColorBrush x:Key="TextFillColorTertiaryBrush" Color="#FF8A8A93" />
    <SolidColorBrush x:Key="TextFillColorDisabledBrush" Color="#FF6C6C74" />

    <SolidColorBrush x:Key="ControlFillColorDefaultBrush" Color="#FF303034" />
    <SolidColorBrush x:Key="ControlFillColorSecondaryBrush" Color="#FF38383C" />
    <SolidColorBrush x:Key="ControlFillColorTertiaryBrush" Color="#FF2B2B2E" />
    <SolidColorBrush x:Key="ControlStrokeColorDefaultBrush" Color="#FF3C3C41" />
    <SolidColorBrush x:Key="ControlStrokeColorSecondaryBrush" Color="#FF333337" />

    <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="#FF2E2E31" />
    <SolidColorBrush x:Key="CardBackgroundFillColorSecondaryBrush" Color="#FF2B2B2E" />
    <SolidColorBrush x:Key="CardStrokeColorDefaultBrush" Color="#FF3A3A3E" />
    <SolidColorBrush x:Key="DividerStrokeColorDefaultBrush" Color="#FF34343A" />

    <SolidColorBrush x:Key="SubtleFillColorSecondaryBrush" Color="#FF2E2E32" />
    <SolidColorBrush x:Key="SubtleFillColorTertiaryBrush" Color="#FF28282B" />
    <SolidColorBrush x:Key="ControlElevationBorderBrush" Color="#FF3C3C41" />
    <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#FF4C9DFF" />
    <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="#FF9DCBFF" />

    <Color x:Key="SystemAccentColor">#FF4C9DFF</Color>
    <Color x:Key="SystemAccentColorPrimary">#FF4C9DFF</Color>
    <Color x:Key="SystemAccentColorSecondary">#FF2F6FBF</Color>
    <Color x:Key="SystemAccentColorTertiary">#FF1E4D8A</Color>

</ResourceDictionary>
