<Window x:Class="Lantern.UI.ShellWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Lantern UI"
        Height="760" Width="1020" MinHeight="560" MinWidth="820"
        WindowStyle="None" ResizeMode="CanResize" WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBaseBrush}"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="34" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ==================== title bar ==================== -->
        <Grid Grid.Row="0">
            <StackPanel x:Name="MacButtons" Orientation="Horizontal" HorizontalAlignment="Left"
                        VerticalAlignment="Center" Margin="14,0,0,0" Background="Transparent"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True">
                <Button x:Name="MacClose" Style="{DynamicResource TrafficLight}" Background="#FFFF5F57"
                        Tag="M 3.5,3.5 L 8.5,8.5 M 8.5,3.5 L 3.5,8.5" Click="Close_Click" />
                <Button x:Name="MacMin" Style="{DynamicResource TrafficLight}" Background="#FFFEBC2E"
                        Tag="M 3,6 L 9,6" Click="Minimize_Click" />
                <Button x:Name="MacMax" Style="{DynamicResource TrafficLight}" Background="#FF28C840"
                        Tag="M 3,6 L 9,6 M 6,3 L 6,9" Click="Maximize_Click" />
            </StackPanel>

            <StackPanel x:Name="WinButtons" Orientation="Horizontal" HorizontalAlignment="Right"
                        Visibility="Collapsed"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True">
                <Button x:Name="WinMin" Style="{DynamicResource CaptionButton}" Tag="M 0,0.5 L 10,0.5"
                        Click="Minimize_Click" />
                <Button x:Name="WinMax" Style="{DynamicResource CaptionButton}" Tag="M 0.5,0.5 L 9.5,0.5 L 9.5,9.5 L 0.5,9.5 Z"
                        Click="Maximize_Click" />
                <Button x:Name="WinClose" Style="{DynamicResource CaptionClose}" Tag="M 0,0 L 10,10 M 10,0 L 0,10"
                        Click="Close_Click" />
            </StackPanel>

            <TextBlock x:Name="TitleText" Text="Lantern UI" FontSize="12"
                       HorizontalAlignment="Center" VerticalAlignment="Center" />

            <Border x:Name="SearchArea" HorizontalAlignment="Left" VerticalAlignment="Center"
                    MinWidth="160" MaxWidth="340" CornerRadius="6" BorderThickness="1"
                    Background="{DynamicResource ControlFillBrush}"
                    BorderBrush="{DynamicResource ControlStrokeBrush}"
                    shell:WindowChrome.IsHitTestVisibleInChrome="True">
                <Grid>
                    <TextBox x:Name="SearchBox" Background="Transparent" BorderThickness="0" Padding="8,3"
                             FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}"
                             CaretBrush="{DynamicResource TextPrimaryBrush}"
                             SelectionBrush="{DynamicResource AccentBrush}"
                             TextChanged="SearchBox_TextChanged"
                             PreviewKeyDown="SearchBox_PreviewKeyDown"
                             GotKeyboardFocus="SearchBox_GotKeyboardFocus" />
                    <TextBlock x:Name="SearchHint" Text="Search settings  (Ctrl+F)" IsHitTestVisible="False"
                               Margin="9,0,0,0" VerticalAlignment="Center" FontSize="12"
                               Foreground="{DynamicResource TextTertiaryBrush}" />
                    <Button x:Name="SearchClear" Content="&#x2715;" HorizontalAlignment="Right"
                            VerticalAlignment="Center" Margin="0,0,2,0" Padding="6,0" FontSize="10"
                            Style="{DynamicResource GhostButton}" Visibility="Collapsed"
                            Click="SearchClear_Click" />
                </Grid>
            </Border>
        </Grid>

        <!-- ==================== tabs (Modern, tabs navigation) ==================== -->
        <Border x:Name="TabStrip" Grid.Row="1" HorizontalAlignment="Center" Margin="0,10,0,8" Padding="3"
                CornerRadius="16" BorderThickness="1"
                Background="{DynamicResource PillTrackBrush}" BorderBrush="{DynamicResource DividerBrush}">
            <StackPanel x:Name="Tabs" Orientation="Horizontal" />
        </Border>

        <!-- ==================== page (with the sidebar layout) ==================== -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!--
                The picture layer clips. The blur needs a negative margin to push its soft edge out of
                sight, and an unclipped margin paints over the rows above — which is how the tab strip
                used to disappear as soon as a background picture was chosen.
            -->
            <Border x:Name="BackdropLayer" Grid.ColumnSpan="2" IsHitTestVisible="False"
                    ClipToBounds="True" Visibility="Collapsed">
                <Grid>
                    <Image x:Name="BackdropImage" Stretch="UniformToFill" SnapsToDevicePixels="True" />
                    <Border x:Name="BackdropShade" />
                </Grid>
            </Border>

            <Border x:Name="Sidebar" Grid.Column="0" Width="190" Margin="12,8,0,8" Padding="6"
                    CornerRadius="12" BorderThickness="1" Visibility="Collapsed"
                    Background="{DynamicResource PillTrackBrush}"
                    BorderBrush="{DynamicResource DividerBrush}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="SideNav" />
                </ScrollViewer>
            </Border>

            <ContentControl x:Name="Host" Grid.Column="1" Focusable="False" />
        </Grid>

        <!-- ==================== activity log ==================== -->
        <Border x:Name="LogPanel" Grid.Row="3" Height="140" Visibility="Collapsed"
                BorderThickness="0,1,0,0" BorderBrush="{DynamicResource DividerBrush}"
                Background="{DynamicResource ContentAreaBrush}">
            <DockPanel>
                <Grid DockPanel.Dock="Top" Margin="14,6,10,2">
                    <TextBlock x:Name="LogTitle" Text="Activity log" FontSize="11.5" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextTertiaryBrush}" />
                    <Button x:Name="LogClear" Content="Clear" HorizontalAlignment="Right" FontSize="11"
                            Style="{DynamicResource GhostButton}" Click="ClearLog_Click" />
                </Grid>
                <ListBox x:Name="LogList" Background="Transparent" BorderThickness="0"
                         FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" />
            </DockPanel>
        </Border>

        <!-- ==================== status bar ==================== -->
        <Border Grid.Row="4" Height="26" BorderThickness="0,1,0,0"
                BorderBrush="{DynamicResource DividerBrush}" Background="{DynamicResource WindowBaseBrush}">
            <Grid Margin="14,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse x:Name="StatusDot" Width="7" Height="7" Fill="{DynamicResource StatusOkBrush}" />
                    <TextBlock x:Name="StatusText" Margin="8,0,0,0" FontSize="11.5" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock x:Name="SavedText" FontSize="11" VerticalAlignment="Center" Margin="0,0,10,0"
                               Foreground="{DynamicResource TextTertiaryBrush}" />
                    <Button x:Name="LogToggle" Content="Log" FontSize="11"
                            Style="{DynamicResource GhostButton}" Click="ToggleLog_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ==================== notifications (bottom right) ==================== -->
        <StackPanel x:Name="ToastHost" Grid.Row="0" Grid.RowSpan="5" VerticalAlignment="Bottom"
                    HorizontalAlignment="Right" Margin="0,0,16,36" Panel.ZIndex="28" />

        <!-- ==================== search results (over the page) ==================== -->
        <Border x:Name="SearchResults" Grid.Row="0" Grid.RowSpan="5" VerticalAlignment="Top" HorizontalAlignment="Left" Width="380"
                MaxHeight="380" Margin="12,40,0,0" Padding="4" CornerRadius="8" BorderThickness="1"
                Visibility="Collapsed" Panel.ZIndex="30"
                Background="{DynamicResource ContentAreaBrush}"
                BorderBrush="{DynamicResource CardStrokeBrush}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="SearchList" />
            </ScrollViewer>
        </Border>
    </Grid>
</Window>
