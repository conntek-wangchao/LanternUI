<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        The dark palette: only brush tokens, no control templates. Every control in the
        framework binds to these keys with DynamicResource, so one dictionary swap
        recolours the whole application at once (see AccentTheme for the accent overlay).
    -->

    <FontFamily x:Key="UiFont">Microsoft YaHei UI, Segoe UI</FontFamily>

    <SolidColorBrush x:Key="WindowBaseBrush" Color="#FF242426" />
    <SolidColorBrush x:Key="ContentAreaBrush" Color="#FF29292B" />
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#FF2E2E31" />
    <SolidColorBrush x:Key="CardStrokeBrush" Color="#FF3A3A3E" />

    <SolidColorBrush x:Key="ControlFillBrush" Color="#FF303034" />
    <SolidColorBrush x:Key="ControlStrokeBrush" Color="#FF3C3C41" />
    <SolidColorBrush x:Key="DividerBrush" Color="#FF34343A" />

    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FFF2F2F4" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#FFB9B9C0" />
    <SolidColorBrush x:Key="TextTertiaryBrush" Color="#FF8A8A93" />

    <SolidColorBrush x:Key="AccentBrush" Color="#FF4C9DFF" />
    <SolidColorBrush x:Key="AccentTextBrush" Color="#FF9DCBFF" />
    <SolidColorBrush x:Key="OnAccentBrush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="SelectedBrush" Color="#FF37373B" />
    <SolidColorBrush x:Key="HoverBrush" Color="#FF2E2E31" />
    <SolidColorBrush x:Key="PillTrackBrush" Color="#FF1E1E21" />

    <SolidColorBrush x:Key="StatusOkBrush" Color="#FF3FA86B" />
    <SolidColorBrush x:Key="StatusWarnBrush" Color="#FFD99A2B" />
    <SolidColorBrush x:Key="StatusBadBrush" Color="#FFC41E3A" />

</ResourceDictionary>
